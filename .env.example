API_TOKEN=generate-a-long-random-string

# --- Existing projects -------------------------------------------------------
# Mac (local dev):
CRAWLERS_DIR=/Users/abubakar.nadeem/Desktop/burgerindex_projects/crawlers
SCHEDULER_DIR=/Users/abubakar.nadeem/Desktop/burgerindex_projects/burgerindex-scheduler
# SCRAPY_BIN must be an interpreter that has the crawlers' own dependencies
# (selenium and friends). The burgerindex-ops venv does not, so a bare `scrapy`
# resolves to the wrong one and `scrapy list` / `scrapy crawl` fail on import.
SCRAPY_BIN=/Users/abubakar.nadeem/Desktop/burgerindex_projects/crawlers/burgerindex/venv/bin/scrapy
# CRAWLERS_DIR may be the repo root; the scrapy project (the directory holding
# scrapy.cfg) is found below it automatically -- see monitor/project.py.
# VM (production), for example:
# CRAWLERS_DIR=/home/arslan/arslan/projects/crawlers
# SCRAPY_BIN=/home/arslan/arslan/projects/venv-scheduler/bin/scrapy

# Read-only user on the scheduler's database.
# The scheduler's Django settings use database 'burgerindex' on 127.0.0.1:5432.
# Create a read-only user there; burgerindex-ops must never write to it.
SCHEDULER_DB_URL=postgresql+psycopg://ops_ro:password@127.0.0.1:5432/burgerindex

# Must return columns: spider, schedule, enabled (optional: last_run_at, client).
# The scheduler runs django_celery_beat's DatabaseScheduler, and its task
# scheduler.tasks.start_crawl(crawler_name) takes the spider POSITIONALLY --
# every CELERY_BEAT_SCHEDULE entry passes 'args': (crawler_name,). So the spider
# is args[0], not a 'spider' key in kwargs.
# Verify with: python scripts/check_schedules.py
SCHEDULES_SQL=SELECT t.args::json->>0 AS spider, c.minute||' '||c.hour||' '||c.day_of_month||' '||c.month_of_year||' '||c.day_of_week AS schedule, t.enabled, t.last_run_at FROM django_celery_beat_periodictask t JOIN django_celery_beat_crontabschedule c ON c.id = t.crontab_id WHERE t.task = 'scheduler.tasks.start_crawl'

# --- Runtime folders (must match the crawlers' settings) ----------------------
# Mirrors a memory limit the crawlers actually enforce, and only draws the RAM
# bar against it. The real crawlers repo sets none (Scrapy's default, 0, means
# unlimited), so leave this 0: the RAM column then shows usage with no limit bar.
# Do not set it to a number the crawlers do not enforce; the bar would turn amber
# against a limit that does not exist. See crawlers_patch/README.md.
MEMUSAGE_LIMIT_MB=0
CRAWLER_LOG_DIR=/var/log/crawlers
HEARTBEAT_DIR=/var/crawler-heartbeat
AUDIT_LOG=/var/log/burgerindex-ops/audit.jsonl

# --- Dashboard + alerts ------------------------------------------------------
DASHBOARD_API=https://data-ingest-dashboard.replit.app
P0_CRAWLERS=talabat-app-deliveroo-1-crawl,talabat-app-deliveroo-2-crawl,talabat-app-deliveroo-3-crawl,talabat-app-mart-uae-crawl
SLACK_WEBHOOK_URL=
# P0 watch remembers which (crawler, job, category) it has already alerted on.
# Losing that file re-alerts every open P0 at once, so it must be persistent --
# never /tmp. Leave blank to use $STATE_DIRECTORY, which the worker unit creates
# as /var/lib/burgerindex-ops. Set it explicitly if you run `python -m
# triage.p0_watch` from cron without the worker, since nothing has created that
# directory for you then.
P0_WATCH_STATE=

# --- Worker + auto-fix -------------------------------------------------------
REDIS_URL=redis://localhost:6379/3
# A separate clone of the crawlers repo, not the prod checkout
AUTOFIX_REPO=/home/arslan/arslan/projects/crawlers-autofix
AUTOFIX_WORK=/var/autofix
GITLAB_PROJECT_ID=
GITLAB_TOKEN=
# MR target: the crawlers repo's default branch is master, not main.
GITLAB_TARGET=master
